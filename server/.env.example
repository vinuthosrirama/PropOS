OPENAI_API_KEY=sk-...
SHEET_URL=https://script.google.com/macros/s/.../exec
PORT=3001

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Gmail API (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID)
# Run: npx ts-node --esm server/scripts/get-gmail-token.ts  to get GMAIL_REFRESH_TOKEN
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=agent@gmail.com

# Test mode — all sends redirect here instead of actual lead contact
TEST_RECIPIENT_PHONE=
TEST_RECIPIENT_EMAIL=
