PORT=3001
BASE_URL=https://propos.addvantage.site

# ── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Add the Railway PostgreSQL plugin and copy the DATABASE_URL it provides
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── Stripe billing ───────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys (use test keys first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create a $399/month recurring price in Stripe Dashboard → copy the Price ID
STRIPE_PRICE_ID=price_...

# ── Google Sheet (Apps Script web app URL) ───────────────────────────────────
SHEET_URL=https://script.google.com/macros/s/.../exec

# ── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...

# ── Gmail API ────────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Run: npx tsx server/scripts/get-gmail-token.ts  to obtain GMAIL_REFRESH_TOKEN
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=agent@gmail.com

# ── BoxDice / Rex CRM ────────────────────────────────────────────────────────
# Your BoxDice subdomain (e.g. "myagency" for myagency.boxdice.com.au)
BOXDICE_DOMAIN=
BOXDICE_API_KEY=

# ── Domain AVM (free tier) ───────────────────────────────────────────────────
# Register at https://developer.domain.com.au to get a free API key
DOMAIN_API_KEY=

# ── Test mode ────────────────────────────────────────────────────────────────
# Remove these in production — they redirect ALL outreach to these addresses
TEST_RECIPIENT_PHONE=
TEST_RECIPIENT_EMAIL=
